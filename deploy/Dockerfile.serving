# Build the API image first. Package pinned weights so PaaS needs no host bind mount.
ARG API_IMAGE=ddm501-biometric-demo-api:latest
FROM ${API_IMAGE}
USER root
COPY --chown=10001:10001 models/face_detection_yunet_2023mar.onnx /models/
COPY --chown=10001:10001 models/face_recognition_sface_2021dec.onnx /models/
COPY --chown=10001:10001 models/speechbrain-ecapa /models/speechbrain-ecapa
COPY --chown=10001:10001 models/minifasnet_v2.onnx models/aasist.pth /models/
ENV MODEL_DIR=/models
USER appuser
