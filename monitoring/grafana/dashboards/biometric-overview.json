{
  "uid": "biometric-overview",
  "title": "DDM501 — System Overview",
  "schemaVersion": 41,
  "version": 3,
  "description": "Tổng quan vận hành toàn hệ thống từ telemetry hiện có. Chi tiết debug/evaluation xem các liên kết. Không thay alert rules hoặc instrumentation.",
  "editable": false,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "ddm501",
    "monitoring"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Serving readiness",
      "type": "stat",
      "description": "Readiness nội bộ; không phải uptime từ phía khách hàng. 0 = unavailable, 1 = ready. Thiếu telemetry = chưa rõ.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "biometric_service_health{service=~\"api|portal|minio\"} and on() (up{job=\"ops-monitor\"} == 1) and on() (time() - max(biometric_ops_last_success_unixtime) < 180)",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "biometric_integrity_capability_ready and on() (up{job=\"biometric-api\"} == 1)",
          "legendFormat": "Integrity detector",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Chưa có dữ liệu",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable",
                  "color": "red"
                },
                "1": {
                  "text": "Ready",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 7
      }
    },
    {
      "id": 2,
      "title": "Active incidents — warning / critical",
      "type": "table",
      "description": "Chỉ lọc hiển thị. Alert rules và việc gửi thông báo giữ nguyên. Bảng trống có thể là không có incident hoặc thiếu telemetry; kiểm tra panel freshness.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\",severity=~\"warning|critical\",evidence!=\"synthetic_demo\",synthetic!=\"true\",alertname!~\".*Synthetic.*|Simulation.*\"}",
          "legendFormat": "{{alertname}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Chưa có dữ liệu"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "severity",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "Value": true,
              "alertstate": true,
              "job": true,
              "instance": true
            },
            "indexByName": {
              "severity": 0,
              "alertname": 1,
              "service": 2,
              "component": 3,
              "modality": 4
            }
          }
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 3,
      "title": "API traffic",
      "type": "timeseries",
      "description": "Request API ngoài health, metrics, admin và simulation; gồm cả enrollment và nghiệp vụ khác. Dùng counter HTTP để tránh trộn observation synthetic vào verification traffic.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(biometric_requests_total{job=\"biometric-api\",route!~\"/health|/ready|/metrics.*|/v1/simulation.*|/v1/admin.*|/docs.*|/openapi.json|/redoc\"}[5m]))",
          "legendFormat": "requests/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Chưa có dữ liệu"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 4,
      "title": "API HTTP 5xx",
      "type": "timeseries",
      "description": "Cùng phạm vi với API traffic. Không có request = chưa có tỷ lệ; không ép về 0. Exception chưa gán route được ghi là unhandled. Review/reject không phải HTTP 5xx.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(biometric_requests_total{job=\"biometric-api\",route!~\"/health|/ready|/metrics.*|/v1/simulation.*|/v1/admin.*|/docs.*|/openapi.json|/redoc\",status=~\"5..\"}[5m])) / sum(rate(biometric_requests_total{job=\"biometric-api\",route!~\"/health|/ready|/metrics.*|/v1/simulation.*|/v1/admin.*|/docs.*|/openapi.json|/redoc\"}[5m]))",
          "legendFormat": "5xx ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Chưa có dữ liệu"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 5,
      "title": "Verification latency p95",
      "type": "timeseries",
      "description": "Thời gian xử lý verification đã được instrumentation; không phải latency HTTP end-to-end và không bao gồm mọi request lỗi. Không có mẫu = chưa có dữ liệu.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(biometric_verification_seconds_bucket{job=\"biometric-api\"}[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Chưa có dữ liệu"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 6,
      "title": "Core containers — CPU / RAM",
      "type": "timeseries",
      "description": "API, PostgreSQL, webhook worker và drift monitor. CPU theo cores; RAM working set theo bytes. Dịch vụ khác xem Explore. Telemetry hiện tại chưa có capacity/limit/disk: panel này không đánh giá phần trăm saturation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(biometric_container_cpu_seconds_total{project=~\"$project\",service=~\"api|postgres|webhook-worker|drift-monitor\"}[5m]))",
          "legendFormat": "{{service}} CPU"
        },
        {
          "refId": "B",
          "expr": "sum by (service) (biometric_container_memory_bytes{project=~\"$project\",service=~\"api|postgres|webhook-worker|drift-monitor\"})",
          "legendFormat": "{{service}} RAM"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Chưa có dữ liệu"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisLabel",
                "value": "CPU cores"
              },
              {
                "id": "custom.axisPlacement",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "custom.axisLabel",
                "value": "RAM"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      }
    },
    {
      "id": 7,
      "title": "Webhook backlog",
      "type": "stat",
      "description": "Số webhook pending/failed hiện tại. Chưa có metric tuổi item chờ lâu nhất; chi tiết xem portal/outbox.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "biometric_webhook_backlog{status=~\"pending|failed\"} and on() (up{job=\"webhook-worker\"} == 1)",
          "legendFormat": "{{status}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Chưa có dữ liệu"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      }
    },
    {
      "id": 8,
      "title": "ML input drift — face / voice",
      "type": "timeseries",
      "description": "Quality/embedding drift: giá trị lớn nhất qua các tenant window theo modality. Hai loại score không nhất thiết cùng thang đo; không áp ngưỡng PSI chung. Xem freshness trước khi diễn giải. Thiếu mẫu không phải drift = 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "biometric_modality_drift_score and on() (up{job=\"ops-monitor\"} == 1)",
          "legendFormat": "{{modality}} / {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Chưa có dữ liệu"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      }
    },
    {
      "id": 9,
      "title": "Human-reviewed quality — FAR / FRR",
      "type": "stat",
      "description": "Chỉ feedback người review, không dùng synthetic. FAR/FRR trên window hiện tại; nhãn available là tổng nhãn monitor đã tải, không phải số genuine/impostor. Thiếu hai lớp hoặc thiếu mẫu = chưa có dữ liệu. Đây là chất lượng trên tập được review, không phải toàn traffic.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "biometric_reviewed_performance{source=\"human\",metric=~\"far|frr\",window=\"current\"} and on(source) (biometric_reviewed_report_success{source=\"human\"} == 1) and on() (up{job=\"drift-monitor\"} == 1)",
          "legendFormat": "{{metric}} / current",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "biometric_reviewed_samples{source=\"human\"} and on() (up{job=\"drift-monitor\"} == 1)",
          "legendFormat": "Human labels available",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Chưa có dữ liệu"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      }
    },
    {
      "id": 10,
      "title": "Pipeline freshness & deployment",
      "type": "stat",
      "description": "Age là tuổi report/calculation/collector/poll, không suy diễn lần DAG thành công từ start_date. Serving bundle là metadata API hiện có; rollout state theo face/voice. Scrape 0 hoặc age tăng cao: telemetry có thể stale. Toàn hệ thống, không lọc tenant.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - biometric_monitoring_etl_unixtime",
          "legendFormat": "Batch report age",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "time() - biometric_monitor_last_success_unixtime",
          "legendFormat": "Drift calculation age",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "max(time() - biometric_ops_last_success_unixtime)",
          "legendFormat": "Oldest collector age",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "expr": "time() - biometric_webhook_last_cycle_unixtime",
          "legendFormat": "Webhook poll age",
          "instant": true,
          "range": false
        },
        {
          "refId": "E",
          "expr": "biometric_monitoring_dag_state == 1",
          "legendFormat": "Monitoring DAG: {{state}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "F",
          "expr": "biometric_deployment_state == 1",
          "legendFormat": "{{modality}} rollout: {{state}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "G",
          "expr": "biometric_model_info and on() (up{job=\"biometric-api\"} == 1)",
          "legendFormat": "Serving bundle: {{version}} / {{backend}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "H",
          "expr": "min(up{job=~\"biometric-api|ops-monitor|drift-monitor|webhook-worker\"})",
          "legendFormat": "Scrape: 1 all up / 0 target down",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Chưa có dữ liệu"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "E"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "F"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "G"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "H"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 10,
        "h": 7
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Container project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(biometric_container_cpu_seconds_total,project)",
        "refresh": 1,
        "current": {
          "text": "ddm501-biometric-demo",
          "value": "ddm501-biometric-demo"
        }
      }
    ]
  },
  "links": [
    {
      "title": "Synthetic simulation",
      "url": "/d/biometric-simulation",
      "type": "link",
      "targetBlank": true
    },
