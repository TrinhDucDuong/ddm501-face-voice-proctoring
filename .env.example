COMPOSE_PROJECT_NAME=ddm501-biometric-demo
POSTGRES_USER=biometric
POSTGRES_PASSWORD=biometric_dev_only
POSTGRES_DB=biometric
DATABASE_URL=postgresql+psycopg://biometric:biometric_dev_only@postgres:5432/biometric
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_only
MLFLOW_BUCKET=mlflow
BIOMETRIC_BUCKET=biometric-samples
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin_dev_only
MODEL_BACKEND=pretrained
MODEL_DIR=/models
STORE_RAW_BIOMETRICS=false
# Enrollment raw storage stays off. Suspicious check evidence is stored independently.
ENABLE_DEMO_REGISTRATION=true
FACE_SPOOF_THRESHOLD=0.5
AUDIO_SPOOF_THRESHOLD=0.5
SPEAKER_CHANGE_THRESHOLD=0.35
FACE_THRESHOLD=0.45
VOICE_THRESHOLD=0.25
API_KEY=demo-internal-key
ENABLE_SIMULATION=true
MONITOR_WINDOW_SIZE=100
PERFORMANCE_WINDOW_SIZE=100
MONITOR_INTERVAL_SECONDS=60
PSI_ALERT_THRESHOLD=0.2
MAX_BIOMETRIC_ERROR_RATE=0.20
API_URL=http://api:8000
PUBLIC_API_URL=http://localhost:18100
WEBHOOK_ALLOWED_HOSTS=legacy-demo,localhost,127.0.0.1
ALLOW_INSECURE_WEBHOOKS=true
# Set separate stable secrets for deployments; demo falls back to API_KEY.
WEBHOOK_MASTER_KEY=
SESSION_SIGNING_KEY=
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
TRAINING_TENANT_ID=demo
CONTINUOUS_TRAINING_ENABLED=true
MONITOR_ETL_WINDOW_SIZE=40
MODEL_OBSERVE_SECONDS=30
REQUIRE_HUMAN_FAIRNESS=false
RAI_REPORT=/opt/project/data/reports/responsible-ai.json
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PUBLIC_GRAFANA_URL=http://localhost:13000/d/biometric-overview
MLFLOW_WORKERS=1
AIRFLOW_PARALLELISM=1
AIRFLOW_WEBSERVER_WORKERS=1
